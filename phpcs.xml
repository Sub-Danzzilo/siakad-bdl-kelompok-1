<?xml version="1.0"?>
<ruleset name="SiAkad">
  <description>Standar kode SiAkad (PSR-12)</description>

  <file>app</file>
  <file>public</file>
  <file>config</file>
  <file>scripts</file>

  <!-- Templat view (campuran HTML + PHP) cukup dicek sintaksnya lewat lint:syntax -->
  <exclude-pattern>*/app/views/*</exclude-pattern>
  <exclude-pattern>*/vendor/*</exclude-pattern>

  <arg name="colors"/>
  <arg name="extensions" value="php"/>
  <arg value="sp"/>

  <rule ref="PSR12"/>

  <!-- bootstrap.php sengaja berisi define() + logika awal -->
  <rule ref="PSR1.Files.SideEffects">
    <exclude-pattern>*/app/bootstrap.php</exclude-pattern>
  </rule>

  <rule ref="Generic.Files.LineLength">
    <properties>
      <property name="lineLimit" value="140"/>
      <property name="absoluteLineLimit" value="0"/>
    </properties>
  </rule>
</ruleset>
